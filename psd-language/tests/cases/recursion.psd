# Recursion and mutual recursion

fn fact(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn is_even(n: int) -> bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

fn is_odd(n: int) -> bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

fn main() {
    print(fact(10))
    print(fact(20))
    print(is_even(10), is_odd(7), is_even(3))
}
