# Arithmetic, floats, conversions

fn area(w: float, h: float) -> float {
    return w * h
}

fn main() {
    print(7 + 3, 7 - 3, 7 * 3, 7 / 3, 7 % 3)
    print(7.0 / 2.0, 1.5 + 2, 3 * 0.5)
    print(area(2.0, 3.5))
    print(-5, -2.5, not true, not false)
    print(10 / 5)
    print(int(3.9), int("42"), float(7), str(2.5))
    print(1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 1 == 1, 1 != 2)
    print(1.5 < 2.5, 2.5 == 2.5)
    print(true and false, true or false, true and true)
    print(3 + 4.5)
}
