# v0.4 agent/data/web stdlibs (offline: canned model reply, no network)
import "std/data.psd" as data
import "std/agent.psd" as agent
import "std/web.psd" as web

fn main() {
    # datasets: CSV -> matrix, JSONL fine-tune examples round-trip
    let nums = data.csv_numbers("x,y\n1,2\n3,4\n", true)
    print(nums["ok"])
    let m = data.to_matrix(nums["value"])
    print(m[1][0], data.column(m, 1)[0], len(data.features(m, 1)[0]))
    let rows: [json] = []
    rows.push(data.chat_example("sys", "hi", "hello"))
    rows.push(data.instruction_example("add", "4"))
    print(data.save_jsonl("/tmp/psd_agentx_ds.jsonl", rows)["ok"])
    let back = data.load_jsonl("/tmp/psd_agentx_ds.jsonl")
    print(back["ok"], len(back["value"]))
    print(str(back["value"][0]["messages"][1]["content"]))

    # tool plumbing: schema + payload + canned tool-call reply
    let tools: [json] = []
    tools.push(agent.tool_spec("read_file", "read a file", agent.string_params(["path"])))
    let msgs: [json] = []
    msgs.push(agent.system_msg("be useful"))
    msgs.push(agent.user_msg("read notes"))
    let payload = agent.chat_payload("test-model", msgs, tools)
    print(str(payload["model"]), len(payload["tools"]), len(payload["messages"]))
    let resp = json_parse("{\"choices\": [{\"message\": {\"content\": \"\", \"tool_calls\": [{\"id\": \"c1\", \"function\": {\"name\": \"read_file\", \"arguments\": \"{\\\"path\\\": \\\"a.txt\\\"}\"}}]}}]}")
    print(agent.wants_tools(resp), agent.reply_content(resp) == "")
    let calls = agent.tool_calls(resp)
    print(str(calls[0]["name"]), str(calls[0]["args"]["path"]))
    print(str(agent.tool_result("c1", "done")["role"]))

    # web components: forms decoded, text escaped at render
    print(web.form_value("a=1&b=hello+world", "b"))
    print(str(web.parse_form("x=%3Cb%3E")["x"]))
    print(web.h1("<hi>"))
    print(web.list_items(["a", "<b>"]))
}
