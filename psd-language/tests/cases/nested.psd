# Nested containers: lists of maps, maps of lists, deep json round-trips

fn main() {
    # map of lists
    let groups: {str: [int]} = {"evens": [2, 4], "odds": [1, 3]}
    push(groups["evens"], 6)
    print(groups["evens"].len(), groups["odds"][1])

    # list of maps
    let people: [{str: int}] = [{"a": 1}, {"a": 2}]
    people[1]["a"] += 20
    print(people[0]["a"], people[1]["a"])

    # deep json round-trip through encode -> parse -> index
    let tree = {"a": {"b": {"c": [1, {"d": "deep"}]}}}
    let copy = json_parse(json_encode(tree))
    print(str(copy["a"]["b"]["c"][1]["d"]))
    print(json_encode(copy) == json_encode(tree))

    # json array of objects, mutated in place
    let rows = [{"n": 1}, {"n": 2}, {"n": 3}]
    let total = 0
    for r in rows {
        total += int(r["n"])
        r["n"] = 0
    }
    print(total, json_encode(rows))

    # ownership churn: many temporary containers (ASAN exercises RC)
    let acc = 0
    for i in range(0, 50) {
        let tmp = {"v": [i, i + 1], "s": "x"}
        acc += int(tmp["v"][1])
    }
    print(acc)
}
