# String and list methods

fn main() {
    let s = "  Hello, World  "
    print(s.trim())
    print(s.trim().upper(), s.trim().lower())
    print(s.contains("World"), s.contains("xyz"))
    print(s.trim().starts_with("Hello"), s.trim().ends_with("World"))
    print(s.trim().replace("World", "PSD"))
    print(s.trim().len())

    let parts = "a,b,c,d".split(",")
    print(len(parts), parts[0], parts[3])
    print(parts.join(" | "))
    print("ab".repeat(3))
    print("42".to_int() + 1, "3.5".to_float() + 0.5)

    let xs = [3, 1, 2]
    xs.push(4)
    print(xs.len(), xs.contains(2), xs.contains(9))
    print(xs.pop())
    xs.reverse()
    print(xs[0], xs[1], xs[2])
    print([1, 2, 3].join("-"))
    print(["a", "b"].join(","))
    print([1.5, 2.5].join(" and "))
}
