# Tiny CPU ML: ordinary least squares via closed-form normal equations.
#
# Scope: scalar models on [float] data (the kind you use for calibrating
# thresholds, fitting rates, and simple predictors inside automations).
# NOT a tensor library: no GPU, no autograd, no framework compatibility.
# For real ML work, orchestrate a Python/R trainer from PSD (see
# examples/ml_interop.psd) and keep using json for parameters.

# Fit y = w*x + b by least squares. Returns a model as json:
#   {"ok": true, "w": ..., "b": ..., "loss": ..., "n": ...}
#   {"ok": false, "error": "..."} on bad input
fn fit(xs: [float], ys: [float]) -> json {
    let n = len(xs)
    if n == 0 or n != len(ys) {
        return {"ok": false, "error": "fit: xs and ys must be non-empty and equal length"}
    }
    let nf = float(n)
    let mx = mean(xs)
    let my = mean(ys)
    let sxx = sum_dev_sq(xs, mx)
    let sxy = sum_dev_prod(xs, ys, mx, my)
    if sxx == 0.0 {
        return {"ok": false, "error": "fit: xs has zero variance"}
    }
    let w = sxy / sxx
    let b = my - w * mx
    let m = {"ok": true, "w": w, "b": b}
    return {"ok": true, "w": w, "b": b, "loss": loss(m, xs, ys), "n": float(n)}
}

fn mean(xs: [float]) -> float {
    let n = len(xs)
    if n == 0 {
        return 0.0
    }
    let total = sum(xs)
    return total / float(n)
}

fn sum(xs: [float]) -> float {
    let total = 0.0
    for i in range(len(xs)) {
        total = total + xs[i]
    }
    return total
}

fn sum_dev_sq(xs: [float], m: float) -> float {
    let total = 0.0
    for i in range(len(xs)) {
        let d = xs[i] - m
        total = total + d * d
    }
    return total
}

fn sum_dev_prod(xs: [float], ys: [float], mx: float, my: float) -> float {
    let total = 0.0
    for i in range(len(xs)) {
        total = total + (xs[i] - mx) * (ys[i] - my)
    }
    return total
}

# Mean squared error of a model over a dataset.
fn loss(m: json, xs: [float], ys: [float]) -> float {
    let n = len(xs)
    if n == 0 {
        return 0.0
    }
    let total = 0.0
    for i in range(n) {
        let d = predict(m, xs[i]) - ys[i]
        total = total + d * d
    }
    return total / float(n)
}

# Inference: y = w*x + b.
fn predict(m: json, x: float) -> float {
    return float(m["w"]) * x + float(m["b"])
}

# Persist parameters as a json file (round-trips with load()).
fn save(path: str, m: json) -> json {
    let r = try_write_file(path, json_encode(m))
    if r["ok"] {
        return {"ok": true, "value": true}
    }
    return {"ok": false, "error": str(r["error"])}
}

fn load(path: str) -> json {
    let r = try_read_file(path)
    if r["ok"] {
        let parsed = try_json_parse(str(r["value"]))
        if parsed["ok"] {
            let m = parsed["value"]
            if m.has("w") and m.has("b") {
                return {"ok": true, "value": m}
            }
            return {"ok": false, "error": "load: model file lacks w/b"}
        }
        return {"ok": false, "error": "load: model file is not valid json"}
    }
    return {"ok": false, "error": str(r["error"])}
}

# ---- v0.4: multivariate + classification + metrics -----------------------
# Models stay plain json, so they save/load, travel over HTTP, and can be
# handed to (or received from) an external trainer unchanged.

fn sigmoid(x: float) -> float {
    return 1.0 / (1.0 + exp(0.0 - x))
}

fn dot(w: [float], x: [float]) -> float {
    let total = 0.0
    for j in range(len(w)) {
        total = total + w[j] * x[j]
    }
    return total
}

fn weights_of(m: json) -> [float] {
    let out: [float] = []
    let ws = m["weights"]
    for j in range(len(ws)) {
        out.push(float(ws[j]))
    }
    return out
}

# Multivariate linear regression y = w.x + b by full-batch gradient descent
# (deterministic: zero init, fixed order). Returns:
#   {"ok": true, "weights": [...], "b": ..., "loss": ...}
fn fit_multi(xs: [[float]], ys: [float], lr: float, epochs: int) -> json {
    if len(xs) == 0 or len(xs) != len(ys) {
        return {"ok": false, "error": "fit_multi: xs and ys must be non-empty and equal length"}
    }
    let d = len(xs[0])
    let w: [float] = []
    for j in range(d) {
        w.push(0.0)
    }
    let b = 0.0
    let nf = float(len(xs))
    for epoch in range(epochs) {
        let gw: [float] = []
        for j in range(d) {
            gw.push(0.0)
        }
        let gb = 0.0
        for i in range(len(xs)) {
            let err = dot(w, xs[i]) + b - ys[i]
            for j in range(d) {
                gw[j] = gw[j] + err * xs[i][j]
            }
            gb = gb + err
        }
        for j in range(d) {
            w[j] = w[j] - lr * 2.0 * gw[j] / nf
        }
        b = b - lr * 2.0 * gb / nf
    }
    let wj: json = []
    for j in range(d) {
        wj.push(w[j])
    }
    let m = {"ok": true, "weights": wj, "b": b}
    return {"ok": true, "weights": wj, "b": b, "loss": loss_multi(m, xs, ys), "n": float(len(xs))}
}

fn predict_multi(m: json, x: [float]) -> float {
    return dot(weights_of(m), x) + float(m["b"])
}

fn loss_multi(m: json, xs: [[float]], ys: [float]) -> float {
    if len(xs) == 0 {
        return 0.0
    }
    let total = 0.0
    for i in range(len(xs)) {
        let d = predict_multi(m, xs[i]) - ys[i]
        total = total + d * d
    }
    return total / float(len(xs))
}

# Binary logistic regression (labels 0.0/1.0), full-batch gradient descent
# on cross-entropy via the sigmoid gradient. Deterministic like fit_multi.
fn fit_logistic(xs: [[float]], ys: [float], lr: float, epochs: int) -> json {
    if len(xs) == 0 or len(xs) != len(ys) {
        return {"ok": false, "error": "fit_logistic: xs and ys must be non-empty and equal length"}
    }
    let d = len(xs[0])
    let w: [float] = []
    for j in range(d) {
        w.push(0.0)
    }
    let b = 0.0
    let nf = float(len(xs))
    for epoch in range(epochs) {
        let gw: [float] = []
        for j in range(d) {
            gw.push(0.0)
        }
        let gb = 0.0
        for i in range(len(xs)) {
            let err = sigmoid(dot(w, xs[i]) + b) - ys[i]
            for j in range(d) {
                gw[j] = gw[j] + err * xs[i][j]
            }
            gb = gb + err
        }
        for j in range(d) {
            w[j] = w[j] - lr * gw[j] / nf
        }
        b = b - lr * gb / nf
    }
    let wj: json = []
    for j in range(d) {
        wj.push(w[j])
    }
    let m = {"ok": true, "weights": wj, "b": b}
    return {"ok": true, "weights": wj, "b": b, "loss": loss_multi(m, xs, ys), "n": float(len(xs))}
}

fn predict_proba(m: json, x: [float]) -> float {
    return sigmoid(predict_multi(m, x))
}

fn predict_label(m: json, x: [float]) -> int {
    if predict_proba(m, x) >= 0.5 {
        return 1
    }
    return 0
}

# Fraction of rows whose predicted label equals int(y).
fn accuracy(m: json, xs: [[float]], ys: [float]) -> float {
    if len(xs) == 0 {
        return 0.0
    }
    let hits = 0
    for i in range(len(xs)) {
        if predict_label(m, xs[i]) == int(ys[i]) {
            hits = hits + 1
        }
    }
    return float(hits) / float(len(xs))
}

# Root mean squared error of the scalar model from fit().
fn rmse(m: json, xs: [float], ys: [float]) -> float {
    return sqrt(loss(m, xs, ys))
}

# Coefficient of determination of arbitrary predictions (1.0 = perfect).
fn r2(ys: [float], preds: [float]) -> float {
    if len(ys) == 0 {
        return 0.0
    }
    let my = mean(ys)
    let ss_tot = 0.0
    let ss_res = 0.0
    for i in range(len(ys)) {
        let d0 = ys[i] - my
        ss_tot = ss_tot + d0 * d0
        let d1 = ys[i] - preds[i]
        ss_res = ss_res + d1 * d1
    }
    if ss_tot == 0.0 {
        return 0.0
    }
    return 1.0 - ss_res / ss_tot
}

fn stddev(xs: [float]) -> float {
    if len(xs) == 0 {
        return 0.0
    }
    let m = mean(xs)
    return sqrt(sum_dev_sq(xs, m) / float(len(xs)))
}

# Feature scaling: fit per-column mean/std once, apply anywhere.
fn fit_scaler(xs: [[float]]) -> json {
    let d = len(xs[0])
    let means: json = []
    let stds: json = []
    for j in range(d) {
        let col: [float] = []
        for i in range(len(xs)) {
            col.push(xs[i][j])
        }
        means.push(mean(col))
        let sd = stddev(col)
        if sd == 0.0 {
            stds.push(1.0)
        } else {
            stds.push(sd)
        }
    }
    return {"means": means, "stds": stds}
}

fn apply_scaler(xs: [[float]], scaler: json) -> [[float]] {
    let out: [[float]] = []
    for i in range(len(xs)) {
        let row: [float] = []
        for j in range(len(xs[i])) {
            row.push((xs[i][j] - float(scaler["means"][j])) / float(scaler["stds"][j]))
        }
        out.push(row)
    }
    return out
}

# Deterministic split: every k-th row (i % k == 0) goes to test.
fn train_test_split(xs: [float], ys: [float], k: int) -> json {
    let xtr: json = []
    let ytr: json = []
    let xte: json = []
    let yte: json = []
    for i in range(len(xs)) {
        if k > 1 and i % k == 0 {
            xte.push(xs[i])
            yte.push(ys[i])
        } else {
            xtr.push(xs[i])
            ytr.push(ys[i])
        }
    }
    return {"x_train": xtr, "y_train": ytr, "x_test": xte, "y_test": yte}
}
