# Numeric arrays on [[float]]: the matrix layer PSD was missing.
#
# Matrices are plain nested lists, so they convert to/from json freely
# (models, datasets, files). Because PSD compiles to native code, these
# loops run at compiled speed — the same code in pure Python is many
# times slower (see bench/nn_compare.py). Honest limits: 2-D only, no
# broadcasting, no GPU; shapes are your responsibility (helpers assume
# valid dimensions, like most array code).

fn zeros(rows: int, cols: int) -> [[float]] {
    let out: [[float]] = []
    for i in range(rows) {
        let row: [float] = []
        for j in range(cols) {
            row.push(0.0)
        }
        out.push(row)
    }
    return out
}

fn identity(n: int) -> [[float]] {
    let out = zeros(n, n)
    for i in range(n) {
        out[i][i] = 1.0
    }
    return out
}

fn matmul(a: [[float]], b: [[float]]) -> [[float]] {
    let out = zeros(len(a), len(b[0]))
    for i in range(len(a)) {
        for k in range(len(b)) {
            let aik = a[i][k]
            if aik != 0.0 {
                for j in range(len(b[0])) {
                    out[i][j] = out[i][j] + aik * b[k][j]
                }
            }
        }
    }
    return out
}

fn transpose(a: [[float]]) -> [[float]] {
    let out = zeros(len(a[0]), len(a))
    for i in range(len(a)) {
        for j in range(len(a[0])) {
            out[j][i] = a[i][j]
        }
    }
    return out
}

fn matvec(a: [[float]], x: [float]) -> [float] {
    let out: [float] = []
    for i in range(len(a)) {
        let total = 0.0
        for j in range(len(x)) {
            total = total + a[i][j] * x[j]
        }
        out.push(total)
    }
    return out
}

fn dot_vec(a: [float], b: [float]) -> float {
    let total = 0.0
    for i in range(len(a)) {
        total = total + a[i] * b[i]
    }
    return total
}

fn add_vec(a: [float], b: [float]) -> [float] {
    let out: [float] = []
    for i in range(len(a)) {
        out.push(a[i] + b[i])
    }
    return out
}

fn sigmoid_vec(a: [float]) -> [float] {
    let out: [float] = []
    for i in range(len(a)) {
        out.push(1.0 / (1.0 + exp(0.0 - a[i])))
    }
    return out
}

fn tanh_vec(a: [float]) -> [float] {
    let out: [float] = []
    for i in range(len(a)) {
        let e = exp(a[i])
        let em = exp(0.0 - a[i])
        out.push((e - em) / (e + em))
    }
    return out
}

fn scale_mat(a: [[float]], s: float) -> [[float]] {
    let out = zeros(len(a), len(a[0]))
    for i in range(len(a)) {
        for j in range(len(a[0])) {
            out[i][j] = a[i][j] * s
        }
    }
    return out
}
