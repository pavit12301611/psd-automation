fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn abs(x: int) -> int {
    if x < 0 {
        return -x
    }
    return x
}

fn sign(x: int) -> int {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return -1
    }
    return 0
}

fn clamp(x: int, lo: int, hi: int) -> int {
    return min(max(x, lo), hi)
}

fn powi(base: int, exp: int) -> int {
    let result = 1
    for i in range(exp) {
        result = result * base
    }
    return result
}

fn absf(x: float) -> float {
    if x < 0.0 {
        return -x
    }
    return x
}

fn minf(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

fn maxf(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

# |a - b| <= tol  (float comparison helper for tests and calibrations)
fn approx(a: float, b: float, tol: float) -> bool {
    return absf(a - b) <= tol
}
