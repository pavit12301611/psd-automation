# Tiny web-UI kit for PSD's built-in HTTP server (the GUI story).
#
# PSD GUIs are server-rendered pages: handlers return HTML strings built
# with these components, dynamic text is escaped by default, forms POST
# back, and http_redirect() drives the flow. All rendering lives here so a
# page handler reads as layout, not string surgery:
#
#   http_reply(200, "text/html; charset=utf-8",
#              web.page("Notes", web.h1("Notes") + web.list_items(notes)))
#
# Interactive desktop/mobile GUIs beyond the browser remain a non-goal;
# the browser is the cross-platform GUI runtime.

# Escape dynamic text (components below escape their text for you).
fn esc(s: str) -> str {
    return html_escape(s)
}

# Full page shell. `body` is trusted HTML (build it with the components).
fn page(title: str, body: str) -> str {
    return "<!doctype html><html><head><meta charset=utf-8><title>" +
    html_escape(title) + "</title><style>" +
    "body{font-family:sans-serif;max-width:44rem;margin:3rem auto;" +
    "padding:0 1rem;line-height:1.55}input,select,textarea{padding:.4rem}" +
    "button{padding:.4rem .8rem}table{border-collapse:collapse}" +
    "td,th{border:1px solid #ccc;padding:.3rem .6rem;text-align:left}" +
    "nav a{margin-right:1rem}.err{color:#b00}.ok{color:#070}" +
    "</style></head><body>" + body + "</body></html>"
}

fn h1(text: str) -> str {
    return "<h1>" + html_escape(text) + "</h1>"
}

fn h2(text: str) -> str {
    return "<h2>" + html_escape(text) + "</h2>"
}

fn p(text: str) -> str {
    return "<p>" + html_escape(text) + "</p>"
}

fn link(href: str, text: str) -> str {
    return "<a href=\"" + html_escape(href) + "\">" + html_escape(text) + "</a>"
}

fn nav(links: [str], labels: [str]) -> str {
    let out = "<nav>"
    for i in range(len(links)) {
        out = out + link(links[i], labels[i])
    }
    return out + "</nav>"
}

# <ul> from plain strings (each escaped).
fn list_items(items: [str]) -> str {
    let out = "<ul>"
    for i in range(len(items)) {
        out = out + "<li>" + html_escape(items[i]) + "</li>"
    }
    return out + "</ul>"
}

# Table from a header row + json rows (each row a json array of cells).
fn table(headers: [str], rows: json) -> str {
    let out = "<table><tr>"
    for i in range(len(headers)) {
        out = out + "<th>" + html_escape(headers[i]) + "</th>"
    }
    out = out + "</tr>"
    for r in range(len(rows)) {
        out = out + "<tr>"
        let row = rows[r]
        for c in range(len(row)) {
            out = out + "<td>" + html_escape(str(row[c])) + "</td>"
        }
        out = out + "</tr>"
    }
    return out + "</table>"
}

# ---- forms -------------------------------------------------------------------
fn form_open(action: str) -> str {
    return "<form method=post action=\"" + html_escape(action) + "\">"
}

fn form_close() -> str {
    return "</form>"
}

fn text_input(name: str, placeholder: str) -> str {
    return "<input name=\"" + html_escape(name) + "\" placeholder=\"" +
    html_escape(placeholder) + "\">"
}

fn submit_button(label: str) -> str {
    return "<button>" + html_escape(label) + "</button>"
}

# Parse an application/x-www-form-urlencoded body (or query string) into a
# json object of str values. The stdlib replacement for hand-split("&").
fn parse_form(body: str) -> json {
    let out: json = {}
    if len(body) == 0 {
        return out
    }
    let parts = body.split("&")
    for i in range(len(parts)) {
        let kv = parts[i].split("=")
        if len(kv) == 2 {
            out[url_decode(kv[0])] = url_decode(kv[1])
        } else {
            if len(kv) == 1 and len(kv[0]) > 0 {
                out[url_decode(kv[0])] = ""
            }
        }
    }
    return out
}

# One field from a form body / query string ("" when absent).
fn form_value(body: str, key: str) -> str {
    let fields = parse_form(body)
    if fields.has(key) {
        return str(fields[key])
    }
    return ""
}

# ---- replies -------------------------------------------------------------------
fn reply_html(status: int, body: str) {
    http_reply(status, "text/html; charset=utf-8", body)
}

fn reply_json(status: int, value: json) {
    http_reply(status, "application/json", json_encode(value))
}

fn reply_page(title: str, body: str) {
    http_reply(200, "text/html; charset=utf-8", page(title, body))
}

fn not_found(what: str) {
    http_reply(404, "text/html; charset=utf-8",
        page("404", h1("404") + p("no such " + what)))
}

fn redirect_to(url: str) {
    http_redirect(url)
}

# --- mobile / PWA helpers (capability expansion) -------------------------
# page_styled is the styled variant of page() above: full document with
# responsive viewport + embedded <style>. base_css() is a fluid layout
# with large touch targets and small-screen rules.

fn page_styled(title: str, css: str, body: str) -> str {
    return "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>" + esc(title) + "</title><style>" + css + "</style></head><body>" + body + "</body></html>"
}

# PWA manifest body as a string: serve it from a /manifest.json route
# (status 200, content type application/json) and link it in <head>
# with <link rel="manifest" href="/manifest.json">.
fn pwa_manifest(name: str, short_name: str, theme_color: str) -> str {
    return "{\"name\":\"" + name + "\",\"short_name\":\"" + short_name + "\",\"start_url\":\"/\",\"display\":\"standalone\",\"background_color\":\"#ffffff\",\"theme_color\":\"" + theme_color + "\"}"
}

fn button_link(href: str, label: str) -> str {
    return "<a class=\"btn\" href=\"" + href + "\">" + esc(label) + "</a>"
}

fn input_field(name: str, label: str, value: str) -> str {
    return "<label>" + esc(label) + " <input name=\"" + name + "\" value=\"" + esc(value) + "\"></label>"
}

fn select_field(name: str, label: str, options: [str]) -> str {
    let out = "<label>" + esc(label) + " <select name=\"" + name + "\">"
    for i in range(len(options)) {
        out = out + "<option>" + esc(options[i]) + "</option>"
    }
    return out + "</select></label>"
}

fn card(title: str, body_html: str) -> str {
    return "<section class=\"card\"><h2>" + esc(title) + "</h2>" + body_html + "</section>"
}

fn table_html(headers: [str], rows: [[str]]) -> str {
    let out = "<table><tr>"
    for h in range(len(headers)) {
        out = out + "<th>" + esc(headers[h]) + "</th>"
    }
    out = out + "</tr>"
    for r in range(len(rows)) {
        out = out + "<tr>"
        for c in range(len(rows[r])) {
            out = out + "<td>" + esc(rows[r][c]) + "</td>"
        }
        out = out + "</tr>"
    }
    return out + "</table>"
}

# First query value for `name` in a request, or "".
fn q1(req: json, name: str) -> str {
    let got = req["query"]
    if got.has(name) {
        return str(got[name])
    }
    return ""
}

fn base_css() -> str {
    return "body{font-family:system-ui;margin:0;padding:16px;max-width:880px;margin-inline:auto} .btn{display:inline-block;padding:12px 16px;background:#2563eb;color:#fff;border-radius:10px;text-decoration:none;min-height:44px} input,select{padding:10px;font-size:16px} .card{border:1px solid #ddd;border-radius:12px;padding:16px;margin:12px 0} table{border-collapse:collapse;width:100%} td,th{border:1px solid #ddd;padding:8px} @media (max-width:600px){body{padding:10px} table{font-size:14px}}"
}
