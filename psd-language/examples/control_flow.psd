# Control flow: while, break, continue, elif

fn main() {
    let i = 0
    while i < 10 {
        i += 1
        if i % 2 == 0 {
            continue
        }
        if i > 7 {
            break
        }
        print("odd:", i)
    }

    let n = 12
    if n < 0 {
        print("negative")
    } elif n == 0 {
        print("zero")
    } else if n % 2 == 0 {
        print("positive even")
    } else {
        print("positive odd")
    }
}
